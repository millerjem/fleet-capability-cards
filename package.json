{
  "name": "@millerjem/fleet-capability-cards",
  "version": "0.1.0",
  "description": "Composable React cards for fleet capabilities, profile settings, reviewed approvals and rollouts.",
  "type": "module",
  "license": "MIT",
  "author": "John Miller",
  "repository": {
    "type": "git",
    "url": "https://github.com/millerjem/fleet-capability-cards.git"
  },
  "homepage": "https://github.com/millerjem/fleet-capability-cards#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "scripts": {
    "build": "vite build && node scripts.mjs",
    "build:demo": "npm run build && vite build --config vite.demo.config.js",
    "dev": "npm run build && vite --config vite.demo.config.js --host 127.0.0.1",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
